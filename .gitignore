# Dependencies & build
**/node_modules/
**/.next/
**/out/
**/build/
# Vendored CDN libraries ship with the site, even when their path contains build/
!web/public/cdn.jsdelivr.net/**/build/
!web/public/cdn.jsdelivr.net/**/build/**
**/.pnp
**/.pnp.*
**/.yarn/*
!**/.yarn/patches
!**/.yarn/plugins
!**/.yarn/releases
!**/.yarn/versions

# Environment & secrets
**/.env
**/.env.*
!**/.env.example

# Debug & tooling
**/.DS_Store
**/*.pem
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/.pnpm-debug.log*
**/*.tsbuildinfo
**/next-env.d.ts
**/.vercel

# Local scratch / reference (not part of the demo site)
_tmp/
_refs/
served_map29.js
